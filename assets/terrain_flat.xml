<mujoco model="terrain_flat">
  <!-- Minimal flat sand terrain. Includes the rover. -->
  <include file="rover.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.85 0.7 0.55 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.8 0.6 0.5" rgb2="0.4 0.3 0.3" width="512" height="512"/>
    <texture type="2d" name="sand" builtin="checker" rgb1="0.75 0.55 0.35" rgb2="0.65 0.45 0.3" width="200" height="200"/>
    <material name="sand_mat" texture="sand" texrepeat="20 20" specular="0.05" shininess="0.05"/>
  </asset>

  <worldbody>
    <geom name="ground" type="plane" size="40 40 0.1" material="sand_mat"
          friction="1.0 0.05 0.001" contype="1" conaffinity="1"/>
    <light name="sun" pos="0 0 15" dir="0 0 -1" diffuse="0.6 0.6 0.6" castshadow="false"/>
    <geom name="goal_marker" type="cylinder" pos="0 10 0.05" size="0.6 0.05"
          rgba="0.2 0.9 0.2 0.6" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
